{
  "name": "teufelsrad",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Teufelsrad – ein okkulter Roulette-Roguelite-Deckbuilder",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "tsx tests/balance-sim.ts",
    "e2e": "node e2e/smoke.mjs",
    "icons": "node scripts/make-icons.mjs",
    "cap:sync": "npm run build && npx cap sync android",
    "apk": "npm run cap:sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/crimson-pro": "^5.3.0",
    "break_eternity.js": "^2.1.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.20.4",
    "playwright": "1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
